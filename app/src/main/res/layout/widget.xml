<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🏡 HomeFlow • Today" android:textColor="#17324B" android:textStyle="bold" android:textSize="15sp" />
        <TextView android:id="@+id/widget_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AT HOME" android:textColor="#2F9D6A" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/widget_maid" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🧹 Came today" android:textAllCaps="false" android:textSize="11sp" />
        <Button android:id="@+id/widget_milk" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:text="🥛 Delivered" android:textAllCaps="false" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <Button android:id="@+id/widget_away" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="✈ Out of station" android:textAllCaps="false" android:textSize="10sp" />
        <Button android:id="@+id/widget_verify" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:text="✓ Verify today" android:textAllCaps="false" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
